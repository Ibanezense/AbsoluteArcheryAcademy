@@ -0,0 +1,59 @@
+import { ACADEMY_NAMESPACE,AcademyApiError } from '../http/academy-auth.mjs';
+
+export const publishedIndividual=`FROM competitors c JOIN dataset_versions v ON v.dataset_version_id=c.dataset_version_id
+  WHERE v.status='published' AND v.is_current=1 AND EXISTS(SELECT 1 FROM participations p JOIN competitive_classes cc ON cc.dataset_version_id=p.dataset_version_id AND cc.competitive_class_id=p.competitive_class_id WHERE p.dataset_version_id=c.dataset_version_id AND p.competitor_id=c.competitor_id AND cc.event_type='individual')`;
+const precomposed=Array.from('áéíóúüñÁÉÍÓÚÜÑ').reduce((sql,letter)=>`replace(${sql},'${letter}','${letter.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase()}')`,'display_name');
+export const foldedAcademyName='lower('+Array.from('\u0301\u0308\u0303').reduce((sql,mark)=>`replace(${sql},'${mark}','')`,precomposed)+')';
+export function athleteNameKey(name){
+  return String(name).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^\p{L}\p{N}\s]/gu,' ').trim().split(/\s+/).filter(Boolean).sort().join(' ');
+}
+function facts(row){
+  try{return typeof row.canonical_json==='string'?JSON.parse(row.canonical_json):{};}
+  catch{throw new AcademyApiError(503,'IDENTITY_SOURCE_INVALID');}
+}
+export async function searchAcademyAthletes(client,query){
+  const words=String(query).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim().split(/\s+/).filter(Boolean);
+  if(!words.length)return [];
+  const result=await client.execute({sql:`WITH eligible AS (SELECT c.*,ROW_NUMBER() OVER(PARTITION BY c.competitor_id ORDER BY v.published_at DESC,v.dataset_version_id DESC) AS rn ${publishedIndividual}) SELECT * FROM eligible WHERE rn=1 AND ${words.map(()=>`${foldedAcademyName} LIKE ? ESCAPE '\\'`).join(' AND ')} ORDER BY ${foldedAcademyName},competitor_id LIMIT 1001`,args:words.map(word=>`%${word.replace(/[\\%_]/g,'\\$&')}%`)});
+  return result.rows;
+}
+export async function matchingAcademyAthlete(client,competitorId,stored=null){
+  const anchor=await client.execute({sql:`SELECT c.* ${publishedIndividual} AND c.competitor_id=? ORDER BY v.published_at DESC,v.dataset_version_id DESC LIMIT 1`,args:[competitorId]});
+  if(!anchor.rows.length)throw new AcademyApiError(404,'PUBLISHED_INDIVIDUAL_NOT_FOUND');
+  const name=String(stored?.confirmed_name??anchor.rows[0].display_name),key=athleteNameKey(name);
+  if(key!==athleteNameKey(anchor.rows[0].display_name))throw new AcademyApiError(409,'ATHLETE_NAME_CHANGED');
+  const rows=await searchAcademyAthletes(client,key);
+  if(rows.length>1000)throw new AcademyApiError(409,'ATHLETE_GROUP_REQUIRES_REVIEW');
+  const matched=key.split(' ').length<2?[anchor.rows[0]]:rows.filter(row=>athleteNameKey(row.display_name)===key);
+  if(!matched.some(row=>row.competitor_id===competitorId)||matched.length>200)throw new AcademyApiError(409,'ATHLETE_GROUP_REQUIRES_REVIEW');
+  const identities=[...matched.map(facts),...(stored?[facts({canonical_json:stored.confirmed_identity})]:[])];
+  const identity={};
+  for(const field of ['birth_date','world_archery_id','federation_id']){
+    const known=new Set(identities.map(row=>row[field]).filter(value=>value!==null&&value!==undefined&&String(value).trim()!=='').map(value=>String(value).trim()));
+    if(known.size>1)throw new AcademyApiError(409,'ATHLETE_IDENTITY_CONFLICT');
+    if(known.size===1)identity[field]=[...known][0];
+  }
+  if(matched.some(row=>row.identity_status==='ambiguous'))throw new AcademyApiError(409,'ATHLETE_IDENTITY_CONFLICT');
+  return {anchor:anchor.rows[0],identity,members:matched.sort((a,b)=>String(a.competitor_id).localeCompare(String(b.competitor_id)))};
+}
+export async function assertAthleteOwners(client,members,externalId){
+  const ids=members.map(row=>String(row.competitor_id));
+  const owners=await client.execute({sql:`SELECT 1 FROM external_bridges WHERE namespace=? AND link_status='confirmed' AND external_id<>? AND competitor_id IN (${ids.map(()=>'?').join(',')}) LIMIT 1`,args:[ACADEMY_NAMESPACE,externalId,...ids]});
+  if(owners.rows.length)throw new AcademyApiError(409,'IDENTITY_ALREADY_ASSIGNED');
+}
+export async function academyAthleteMembers(client,competitorId,externalId){
+  const anchor=await client.execute({sql:'SELECT g.* FROM academy_athlete_groups g JOIN external_bridges b ON b.competitor_id=g.competitor_id AND b.external_id=g.external_id WHERE b.namespace=? AND b.link_status=\'confirmed\' AND g.competitor_id=? AND g.external_id=?',args:[ACADEMY_NAMESPACE,competitorId,externalId]});
+  if(!anchor.rows.length)throw new AcademyApiError(403,'UNCONFIRMED_EXTERNAL_BRIDGE');
+  const group=await matchingAcademyAthlete(client,competitorId,anchor.rows[0]);
+  await assertAthleteOwners(client,group.members,externalId);
+  return {contract_version:'te-academy-athlete-members-v1',checked_at:new Date().toISOString(),external_id:externalId,anchor_competitor_id:competitorId,competitor_ids:group.members.map(row=>String(row.competitor_id))};
+}
+export async function requireRelatedAthleteBridge(client,competitorId,externalId){
+  const groups=await client.execute({sql:"SELECT g.competitor_id FROM academy_athlete_groups g JOIN external_bridges b ON b.competitor_id=g.competitor_id AND b.external_id=g.external_id WHERE g.external_id=? AND b.namespace=? AND b.link_status='confirmed' LIMIT 201",args:[externalId,ACADEMY_NAMESPACE]});
+  if(groups.rows.length>200)throw new AcademyApiError(409,'ATHLETE_GROUP_REQUIRES_REVIEW');
+  for(const group of groups.rows){
+    const data=await academyAthleteMembers(client,String(group.competitor_id),externalId);
+    if(data.competitor_ids.includes(competitorId))return;
+  }
+  throw new AcademyApiError(403,'UNCONFIRMED_EXTERNAL_BRIDGE');
+}
