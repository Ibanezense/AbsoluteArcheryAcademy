index 0000000..7331613
--- /dev/null
+++ b/tests/integration/academy-athlete-group.test.mjs
@@ -0,0 +1,68 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createClient } from '@libsql/client';
+import { readFile,mkdtemp } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { randomUUID } from 'node:crypto';
+import { performance } from 'node:perf_hooks';
+import { athleteNameKey, matchingAcademyAthlete, academyAthleteMembers } from '../../src/infrastructure/queries/academy-athlete-group.mjs';
+import { applyAcademyIdentityCommand,academyIdentitySearch } from '../../src/infrastructure/queries/academy-identity.mjs';
+import { requireAcademyBridge } from '../../src/infrastructure/queries/academy-progress-read-model.mjs';
+
+test('full names normalize order and accents, while preserving repeated tokens and rejecting partial names',()=>{
+  assert.equal(athleteNameKey('Chávez Guevara Alejandro Joaquín'),athleteNameKey('Alejandro Joaquín Chávez Guevara'));
+  assert.notEqual(athleteNameKey('Alejandro Chávez'),athleteNameKey('Alejandro Joaquín Chávez Guevara'));
+  assert.notEqual(athleteNameKey('Jose Jose Perez'),athleteNameKey('Jose Perez'));
+});
+test('one confirmed athlete covers future tournaments; ownership conflicts, identity contradictions and revocation fail closed',async()=>{
+  const root=await mkdtemp(path.join(os.tmpdir(),'te-athlete-group-'));
+  const db=createClient({url:`file:${path.join(root,'test.db').replaceAll('\\','/')}`});
+  const external='00000000-0000-4000-8000-000000000001';
+  try{
+    await db.executeMultiple(`CREATE TABLE dataset_versions(dataset_version_id TEXT PRIMARY KEY,dataset_id TEXT,status TEXT,is_current INTEGER,published_at TEXT);
+      CREATE TABLE competitors(dataset_version_id TEXT,competitor_id TEXT,display_name TEXT,identity_status TEXT,canonical_json TEXT DEFAULT '{}');
+      CREATE TABLE participations(dataset_version_id TEXT,competitor_id TEXT,competitive_class_id TEXT);
+      CREATE TABLE tournaments(dataset_version_id TEXT,name TEXT,start_date TEXT);
+      CREATE TABLE competitive_classes(dataset_version_id TEXT,competitive_class_id TEXT,event_type TEXT,canonical_json TEXT);
+      CREATE TABLE external_bridges(competitor_id TEXT,namespace TEXT,external_id TEXT,link_status TEXT,verified_at TEXT,PRIMARY KEY(competitor_id,namespace,external_id));
+      INSERT INTO dataset_versions VALUES('v1','ds1','published',1,'2026-10-01T00:00:00Z');
+      INSERT INTO tournaments VALUES('v1','Event','2026-10-01');
+      INSERT INTO competitors VALUES('v1','c1','Alejandro Joaquín Chávez Guevara','unresolved','{}'),('v1','c2','Chavez Guevara Alejandro Joaquin','unresolved','{}'),('v1','partial','Alejandro Chavez','unresolved','{}');
+      INSERT INTO participations VALUES('v1','c1','class1'),('v1','c2','class1'),('v1','partial','class1');
+      INSERT INTO competitive_classes VALUES('v1','class1','individual','{"label":"Recurvo"}');`);
+    await db.executeMultiple(await readFile(new URL('../../db/migrations/0006_academy_identity.sql',import.meta.url),'utf8'));
+    await db.executeMultiple(await readFile(new URL('../../db/migrations/0007_academy_athlete_groups.sql',import.meta.url),'utf8'));
+    const cmd=(operation,generation,id='c1',owner=external)=>({operation,generation,competitor_id:id,external_id:owner,request_id:randomUUID(),actor_id:'00000000-0000-4000-8000-000000000002',evidence:'Administrator confirmed athlete'});
+    await assert.rejects(()=>academyAthleteMembers(db,'c1',external));
+    await applyAcademyIdentityCommand(db,cmd('confirm',1));
+    await db.execute("UPDATE competitors SET display_name='Chavez Guevara Alejandro Joaquin' WHERE competitor_id='c1'");
+    await db.execute("UPDATE competitors SET display_name='Alejandro Joaquin Chavez Guevara' WHERE competitor_id='c2'");
+    assert.equal((await academyIdentitySearch(db,'Alejandro Joaquin Chavez Guevara',external)).candidates[0].competitor_id,'c1','the existing athlete anchor wins over alphabetical tournament order');
+    assert.deepEqual((await academyAthleteMembers(db,'c1',external)).competitor_ids,['c1','c2']);
+    await requireAcademyBridge(db,'c2',external);
+    await assert.rejects(()=>requireAcademyBridge(db,'partial',external));
+    await db.execute("INSERT INTO competitors VALUES('v1','future','Alejandro Joaquin Chavez Guevara','unresolved','{}')");
+    await db.execute("INSERT INTO participations VALUES('v1','future','class1')");
+    assert.deepEqual((await academyAthleteMembers(db,'c1',external)).competitor_ids,['c1','c2','future']);
+    await assert.rejects(()=>applyAcademyIdentityCommand(db,cmd('confirm',1,'c2','00000000-0000-4000-8000-000000000003')));
+    await db.execute(`UPDATE competitors SET canonical_json='{"birth_date":"1990-01-01"}' WHERE competitor_id='c1'`);
+    await db.execute(`UPDATE competitors SET canonical_json='{"birth_date":"2000-01-01"}' WHERE competitor_id='c2'`);
+    await assert.rejects(()=>matchingAcademyAthlete(db,'c1'));
+    await db.execute("UPDATE competitors SET canonical_json='{}'");
+    const additions=Array.from({length:197},(_,index)=>`bulk_${index}`);
+    await db.batch(additions.flatMap(id=>[
+      {sql:"INSERT INTO competitors VALUES('v1',?,'Alejandro Joaquin Chavez Guevara','unresolved','{}')",args:[id]},
+      {sql:"INSERT INTO participations VALUES('v1',?,'class1')",args:[id]},
+    ]),'write');
+    const started=performance.now();
+    assert.equal((await academyAthleteMembers(db,'c1',external)).competitor_ids.length,200);
+    console.info(`Bounded200-member catalogue: ${Math.round(performance.now()-started)}ms (isolated SQLite)`);
+    await db.execute("INSERT INTO competitors VALUES('v1','overflow','Alejandro Joaquin Chavez Guevara','unresolved','{}')");
+    await db.execute("INSERT INTO participations VALUES('v1','overflow','class1')");
+    await assert.rejects(()=>academyAthleteMembers(db,'c1',external),error=>error.code==='ATHLETE_GROUP_REQUIRES_REVIEW');
+    await applyAcademyIdentityCommand(db,cmd('revoke',2));
+    await assert.rejects(()=>requireAcademyBridge(db,'c2',external));
+    await assert.rejects(()=>academyAthleteMembers(db,'c1',external));
+  }finally{db.close();}
+});
