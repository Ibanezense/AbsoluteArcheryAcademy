+++ b/db/migrations/0007_academy_athlete_groups.sql
@@ -0,0 +1,18 @@
+-- Stable name and identifying facts confirmed by the academy. Sporting source rows are untouched.
+CREATE TABLE IF NOT EXISTS academy_athlete_groups (
+  competitor_id TEXT NOT NULL,
+  external_id TEXT NOT NULL,
+  confirmed_name TEXT NOT NULL,
+  confirmed_identity TEXT NOT NULL DEFAULT '{}',
+  confirmed_at TEXT NOT NULL,
+  PRIMARY KEY(competitor_id,external_id)
+);
+CREATE INDEX IF NOT EXISTS ix_academy_athlete_group_external ON academy_athlete_groups(external_id);
+-- Existing manually confirmed links retain their current published name as the approved group anchor.
+INSERT OR IGNORE INTO academy_athlete_groups(competitor_id,external_id,confirmed_name,confirmed_identity,confirmed_at)
+SELECT b.competitor_id,b.external_id,c.display_name,c.canonical_json,b.verified_at
+FROM external_bridges b JOIN competitors c ON c.competitor_id=b.competitor_id
+JOIN dataset_versions v ON v.dataset_version_id=c.dataset_version_id
+WHERE b.namespace='academy_reservas_student' AND b.link_status='confirmed'
+  AND v.status='published' AND v.is_current=1
+  AND v.dataset_version_id=(SELECT cv.dataset_version_id FROM competitors cc JOIN dataset_versions cv ON cv.dataset_version_id=cc.dataset_version_id WHERE cc.competitor_id=b.competitor_id AND cv.status='published' AND cv.is_current=1 ORDER BY cv.published_at DESC,cv.dataset_version_id DESC LIMIT 1);
diff --git a/src/infrastructure/queries/academy-athlete-group.mjs b/src/infrastructure/queries/academy-athlete-group.mjs
