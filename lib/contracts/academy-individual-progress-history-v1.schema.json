{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:te:academy-individual-progress-history-v1",
  "title": "academy-individual-progress-history-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "checked_at",
    "complete",
    "datasets",
    "next_cursor"
  ],
  "properties": {
    "contract_version": {
      "const": "te-academy-individual-progress-history-v1"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "complete": {
      "const": true
    },
    "datasets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id",
          "dataset_version_id",
          "dataset_version",
          "published_at",
          "name",
          "start_date"
        ],
        "properties": {
          "dataset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,160}$"
          },
          "dataset_version_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,160}$"
          },
          "dataset_version": {
            "type": "integer",
            "minimum": 1
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "name": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,160}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
